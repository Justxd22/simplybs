{
    "package": "rust-std",
    "version": "1.95.0",
    "type": "host",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "ea9b82a83e46967537c3569ce9d6fa16811c043a96e651376c349e70241ca515",
            "url": "http://static.rust-lang.org/dist/rustc-1.95.0-src.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_",
        "*:*:native/cmake",
        "*:*:native/make",
        "*:*:native/ninja",
        "*:*:native/python@3.11",
        "*:*:native/rust"
    ],
    "build": {
        "env": [],
        "steps": [
            "*:*:echo '[build]' > config.toml",
            "*:*:echo 'vendor = true' >> config.toml",
            "*:*:echo target = [\\\"$RUST_TRIPLET\\\"] >> config.toml",
            "*:*:echo rustc = \\\"$NATIVEPREFIX/bin/rustc\\\" >> config.toml",
            "*:*:echo cargo = \\\"$NATIVEPREFIX/bin/cargo\\\" >> config.toml",
            "*:*:echo '[llvm]' >> config.toml",
            "*:*:echo 'ninja = true' >> config.toml",
            "*:*:echo 'download-ci-llvm = false' >> config.toml",
            "*:*:echo [target.$RUST_TRIPLET] >> config.toml",
            "*:*:echo cc = \\\"$CC\\\" >> config.toml",
            "*:*:echo cxx = \\\"$CXX\\\" >> config.toml",
            "*:*:echo ar = \\\"$AR\\\" >> config.toml",
            "*:*:echo ranlib = \\\"$RANLIB\\\" >> config.toml",
            "*:*:echo linker = \\\"$CC\\\" >> config.toml",
            "*:*:env -u ARFLAGS python3 ./x.py build library/std --stage 1 --target $RUST_TRIPLET -j $NUM_CORES",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/lib/rustlib",
            "*:*:cp -a build/*/stage1/lib/rustlib/$RUST_TRIPLET $STAGING_DIR$NATIVEPREFIX/lib/rustlib/"
        ]
    }
}